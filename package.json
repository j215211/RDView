{
  "name": "rdview",
  "version": "0.1.0",
  "private": true,
  "description": "RDView 弱电视频监控管理系统 — 局域网内集中管理 NVR / IPC 摄像头,支持 2D 俯瞰图与 3D 模型布点",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:api && npm run build:web",
    "db:push": "npm run prisma:push -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api"
  }
}
